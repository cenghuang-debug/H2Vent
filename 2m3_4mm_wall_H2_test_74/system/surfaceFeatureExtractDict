FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Operate on the metre-scale versions produced by surfaceTransformPoints in Allrun.

nozzle_4mm_3mm_27cm_m.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       170;

    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }

    writeObj            yes;
}

box_shell_2m3_m.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       170;

    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }

    writeObj            yes;
}

