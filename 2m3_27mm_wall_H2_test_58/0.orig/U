FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);  

boundaryField
{
    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            zeroGradient;
    }
    front
    {
        type            zeroGradient;
    }
    back
    {
        type            zeroGradient;
    }
    bottom_wall
    {
        type            noSlip;
    }
    top
    {
        type            zeroGradient;
    }
    nozzle_27mm_5mm_27cm
    {
        type            noSlip;
    }
    nozzle
    {
        // Q = 73 NL/min → ṁ_half = 5.45e-5 kg/s (half domain)
        // U = ṁ/(ρ·A) = 5.45e-5 / (0.08583 × π/2×(0.0135)²) = 2.23 m/s
        // ρ_H2 = 0.08583 kg/m³ at T=286.15 K, P=101325 Pa
        type            uniformFixedValue;
        uniformValue    table
        (
            (0.0    (0 0 0))
            (0.5    (0 0 2.23))
            (100.0  (0 0 2.23))
        );
        value           uniform (0 0 0);
    }
    box_shell_2m3  //wall
    {
        type            noSlip;
    }
}
