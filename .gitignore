# =====================================================
# OpenFOAM H2Vent Parametric Study - .gitignore
# =====================================================

# ── Generated mesh (large, recreated by Allrun) ──
**/polyMesh/
**/extendedFeatureEdgeMesh/

# ── Simulation time-step directories ──
# Matches purely-numeric dirs (0, 10, 20, 41.601358, …)
# Does NOT match 0.orig (has ".orig" suffix)
**/[0-9]/
**/[0-9][0-9]/
**/[0-9][0-9][0-9]/
**/[0-9][0-9][0-9][0-9]/
**/[0-9].[0-9]*/
**/[0-9][0-9].[0-9]*/
**/[0-9][0-9][0-9].[0-9]*/

# ── Simulation results ──
**/postProcessing/
**/VTK/
**/processor*/
**/dynamicCode/

# ── Log / run-time files ──
log.*
**/log.*
*.log
open.foam
**/open.foam
slurm-*.out
slurm-*.err
**/slurm-*.out
**/slurm-*.err

# ── OpenFOAM feature-edge files (generated by surfaceFeatureExtract) ──
*.eMesh
**/*.eMesh

# ── Compiled object / binary files ──
*.o
*.so
*.a

# ── Windows/WSL Zone Identifiers ──
*:Zone.Identifier
**/*:Zone.Identifier

# ── Subdirectories with their own git repos ──
H2VentGitHub/
H2VentGitHub_backup/
