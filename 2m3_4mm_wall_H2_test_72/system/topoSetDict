FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
// After subsetMesh, the 'nozzleChannel' patch contains only the cut-plane
// inlet faces at the top of the removed cylinder (coarser mesh: bore wall is
// fully snapped to nozzle_4mm_1mm_m by snappyHexMesh, so no splitting needed).

// --- nozzle inlet: all faces in nozzleChannel ---
    {
        name    nozzle;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { patch "nozzleChannel"; }
    }

// --- bottom_wall: entire bottom patch (nozzle-channel faces are gone) ---
    {
        name    bottom_wall;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo
            {
                patch "bottom";
            }
    }
