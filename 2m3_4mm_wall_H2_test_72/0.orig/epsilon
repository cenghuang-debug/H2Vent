FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 3.02e-9; //updated

boundaryField
{
    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField; //placeholder
    }
    front
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField; //placeholder
    }
    back
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField; //placeholder
    }
    bottom_wall
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
    top
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField; //placeholder
    }
    nozzle_4mm_3mm_27cm
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
    nozzle
    {
        // Auto-scales with instantaneous k — consistent with U/k ramp.
        // ε = Cμ^(3/4)*k^(3/2)/L, L = 0.07×D = 0.07×4mm = 2.8e-4 m.
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    2.80e-4;
        value           uniform 3.02e-9;
    }
    box_shell_2m3
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
}
