FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);  

boundaryField
{
    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            zeroGradient;
    }
    front
    {
        type            zeroGradient;
    }
    back
    {
        type            zeroGradient;
    }
    bottom_wall
    {
        type            noSlip;
    }
    top
    {
        type            zeroGradient;
    }
    nozzle_4mm_3mm_27cm
    {
        type            noSlip;
    }
    nozzle
    {
        // Ramp 0 → 303 m/s over 0.5 s (+z, upward from floor nozzle).
        // Q = 218.1 NL/min → ṁ_full = 3.268e-4 kg/s → ṁ_half = 1.634e-4 kg/s
        // U = ṁ/(ρ·A) = 1.634e-4 / (0.08583 × π/2×(2e-3)²) ≈ 303 m/s
        // ρ_H2 = 0.08583 kg/m³ at T=286.15 K, P=101325 Pa
        // k/epsilon auto-scale via turbulentIntensityKineticEnergyInlet (I=0.10)
        // and turbulentMixingLengthDissipationRateInlet (L=2.8e-4 m).
        type            uniformFixedValue;
        uniformValue    table
        (
            (0.0    (0 0 0))
            (0.5    (0 0 303))
            (100.0  (0 0 303))
        );
        value           uniform (0 0 0);
    }
    box_shell_2m3  //wall
    {
        type            noSlip;
    }
}
